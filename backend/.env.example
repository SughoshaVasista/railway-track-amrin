# Backend-only settings. Replace the JWT secret locally before enabling auth.
ENVIRONMENT=development
DEMO_MODE=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=60
SENSOR_INGEST_TOKEN=
ML_MODEL_PATH=../runs/detect/railway-crack-hardneg-v1-short/weights/best.pt
ML_CONFIDENCE=0.25
ML_IOU=0.35
ML_IMAGE_SIZE=960
ML_ALERT_COOLDOWN_SECONDS=60
DATABASE_URL=sqlite:///./instance/amrin.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
UPLOAD_FOLDER=./uploads/evidence
MAX_CONTENT_LENGTH=10485760
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_BASE_URL=http://127.0.0.1:5173
