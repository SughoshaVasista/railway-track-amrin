# Backend reachable from the Pi. If backend is on your laptop, use laptop LAN IP:
BACKEND_URL=http://192.168.1.20:8000
ML_INGEST_TOKEN=replace_with_same_value_as_backend_ML_INGEST_TOKEN
SENSOR_INGEST_TOKEN=replace_with_same_value_as_backend_SENSOR_INGEST_TOKEN
API_KEY=replace_with_live_API_X_API_KEY
SENSOR_API_MODE=auto
TELEMETRY_INTERVAL_SECONDS=5
DEVICE_ID=railsafe-pi-01
CAMERA_SENSOR_ID=railsafe-pi-01-camera
GPS_SENSOR_ID=railsafe-pi-01-gps
SOURCE_NAME=railsafe-pi
CITY=Bengaluru

MODEL_PATH=models/best.pt
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
INFERENCE_SIZE=416
CONFIDENCE_THRESHOLD=0.45
CRACK_CLASS_NAMES=crack,rail_crack,rail crack

# DEMO severity thresholds only; align to validated model/risk rules.
SEVERITY_S3_CONFIDENCE=0.85
SEVERITY_S2_CONFIDENCE=0.65

# Keep false until the motor driver and wiring are verified.
MOTOR_ENABLED=false
MOTOR_DRIVER=l298n
MOTOR_LEFT_IN1=12
MOTOR_LEFT_IN2=16
MOTOR_RIGHT_IN1=20
MOTOR_RIGHT_IN2=21
MOTOR_REVERSE_SECONDS=0.8

GPS_PORT=/dev/serial0
GPS_BAUD=9600
GPS_READ_TIMEOUT=0.2
GPS_MAX_AGE_SECONDS=10
